{
    "name": "nmoral/class-viewer",
    "description": "Standalone viewer and navigator for PHP class dependency graphs.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "nikic/php-parser": "^5.9",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "psr-4": {
            "ClassViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClassViewer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/class-viewer"
    ],
    "config": {
        "platform": {
            "php": "8.5.11"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
